{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": [
        "models_onnx/**",
        "static/**",
        "outputs/**",
        "real_presets/**",
        "app.py",
        "nutrition_engine.py",
        "food_taxonomy.py",
        "real_foodseg103_onnx.py",
        "lightweight_5group_segmenter.py"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
